{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance.local/schemas/governance-contracts-v1.json",
  "title": "Governed development contract bundle",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-[a-z0-9][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "enum": ["Product Owner / Reviewer", "Architect", "Implementer"]
    },
    "blocker_category": {
      "enum": [
        "tool-unavailable",
        "credential-invalid",
        "repository-unauthorized",
        "network-unreachable",
        "runtime-capability-denied",
        "workspace-inaccessible",
        "operation-not-permitted",
        "authoritative-state-conflict"
      ]
    },
    "baseline_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "governance_version", "upstream_manifest_url"],
      "properties": {
        "schema_version": {"const": 1},
        "governance_version": {"$ref": "#/$defs/version"},
        "upstream_manifest_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "release_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "migrates_from", "migration"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "migrates_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/version"}
        },
        "migration": {
          "type": ["string", "null"],
          "pattern": "^migrations/[a-z0-9._-]+/manifest\\.json$"
        }
      }
    },
    "release_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "releases"],
      "properties": {
        "schema_version": {"const": 1},
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/release_entry"}
        }
      }
    },
    "installed_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "installed_version", "upstream_manifest_url"],
      "properties": {
        "schema_version": {"const": 1},
        "installed_version": {"$ref": "#/$defs/version"},
        "upstream_manifest_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "issue_handoff_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artefact_type", "identifier", "issue_title",
        "producer_role", "receiver_role", "operation", "payload_path",
        "payload_sha256", "status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "artefact_type": {"const": "issue-specification"},
        "identifier": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "issue_title": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
        "producer_role": {"const": "Architect"},
        "receiver_role": {"const": "Implementer"},
        "operation": {"const": "publish-issue-specification"},
        "payload_path": {"const": "body.md"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "ready"}
      }
    },
    "protocol_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "template", "target", "terminal_state_class",
        "permitted_successors", "human_decision_boundary"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "template": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/role"},
        "terminal_state_class": {
          "enum": ["read-only", "prepared", "submitted", "merged", "cleaned", "closed", "tagged", "decision"]
        },
        "permitted_successors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "human_decision_boundary": {"type": "boolean"}
      }
    },
    "protocol_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "protocol_version", "roles", "targets",
        "result_statuses", "blocker_categories", "triggers"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "protocol_version": {"$ref": "#/$defs/version"},
        "roles": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/role"}
        },
        "targets": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/role"}
        },
        "result_statuses": {
          "type": "array", "const": ["success", "blocked", "protocol-invalid"]
        },
        "blocker_categories": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/blocker_category"}
        },
        "triggers": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/protocol_trigger"}
        }
      }
    },
    "capability_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "state", "blocker_category", "provenance"],
      "properties": {
        "capability": {
          "enum": [
            "tool-availability", "credential-validity", "repository-authorization",
            "network-reachability", "runtime-permission", "workspace-access",
            "mutation-permission", "authoritative-state-consistency"
          ]
        },
        "state": {"enum": ["available", "unavailable", "denied", "unknown"]},
        "blocker_category": {"oneOf": [{"$ref": "#/$defs/blocker_category"}, {"type": "null"}]},
        "provenance": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "available"}}},
          "then": {"properties": {"blocker_category": {"type": "null"}}},
          "else": {"properties": {"blocker_category": {"$ref": "#/$defs/blocker_category"}}}
        }
      ]
    },
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "runtime", "observations"],
      "properties": {
        "schema_version": {"const": 1},
        "runtime": {"type": "string", "minLength": 1},
        "observations": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/capability_observation"}
        }
      }
    },
    "repository_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_with_owner", "url", "default_branch", "commit"],
      "properties": {
        "name_with_owner": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "url": {"type": "string", "format": "uri"},
        "default_branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authority", "provenance"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "authority": {"$ref": "#/$defs/role"},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "work_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "repository", "governance_version", "workstream_id",
        "role", "work_item", "canonical_trigger", "authorized_operation",
        "owner", "target", "expected_terminal_state", "permitted_successors",
        "required_capabilities", "required_validation", "required_evidence",
        "handoff", "human_decisions"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "repository": {"$ref": "#/$defs/repository_identity"},
        "governance_version": {"$ref": "#/$defs/version"},
        "workstream_id": {"type": "string", "minLength": 1},
        "role": {"$ref": "#/$defs/role"},
        "work_item": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "issue": {"type": "integer", "minimum": 1},
            "pull_request": {"type": "integer", "minimum": 1}
          }
        },
        "canonical_trigger": {"type": "string", "minLength": 1},
        "authorized_operation": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/role"},
        "target": {"$ref": "#/$defs/role"},
        "expected_terminal_state": {"type": "string", "minLength": 1},
        "permitted_successors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "required_validation": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "handoff": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["reference", "sha256"],
              "properties": {
                "reference": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        },
        "human_decisions": {"type": "array", "items": {"$ref": "#/$defs/human_decision"}}
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "unavailable"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "terminal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "status", "repository", "provider", "capabilities",
        "produced_objects", "validations", "provenance", "blocker_category",
        "recovery_authority"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"enum": ["success", "blocked", "protocol-invalid"]},
        "repository": {"$ref": "#/$defs/repository_identity"},
        "provider": {"type": "string", "minLength": 1},
        "capabilities": {"$ref": "#/$defs/capability_profile"},
        "produced_objects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "validations": {"type": "array", "items": {"$ref": "#/$defs/validation_result"}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "blocker_category": {"oneOf": [{"$ref": "#/$defs/blocker_category"}, {"type": "null"}]},
        "recovery_authority": {"oneOf": [{"$ref": "#/$defs/role"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "success"}}},
          "then": {
            "properties": {
              "blocker_category": {"type": "null"},
              "recovery_authority": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "blocker_category": {"$ref": "#/$defs/blocker_category"},
              "recovery_authority": {"$ref": "#/$defs/role"}
            }
          }
        }
      ]
    },
    "migration_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ownership", "action", "source_sha256", "target_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "ownership": {"enum": ["upstream-managed", "project-configured", "project-owned", "mixed"]},
        "action": {"enum": ["add", "replace", "render", "preserve", "advance-version", "deferred-metadata"]},
        "source_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "target_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "migration_variant_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "ownership", "action", "source_sha256", "target_sha256",
        "source_match"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "ownership": {"enum": ["upstream-managed", "project-configured", "project-owned", "mixed"]},
        "action": {"enum": ["add", "replace", "render", "preserve", "advance-version", "deferred-metadata"]},
        "source_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "target_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "source_match": {"enum": ["absent", "exact", "present", "unconstrained"]}
      }
    },
    "migration_source_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_repository", "source_product_commit", "files"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"},
        "source_repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "source_product_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/migration_variant_file"}
        }
      }
    },
    "migration_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "migration_type", "source_version", "target_version",
        "source_public_repository", "source_public_manifest_url",
        "source_product_commit", "payload_root", "files"
      ],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "migration_type": {"const": "governance-baseline"},
        "source_version": {"$ref": "#/$defs/version"},
        "target_version": {"$ref": "#/$defs/version"},
        "source_public_repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "source_public_manifest_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_product_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "payload_root": {"const": "payload"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/migration_file"}},
        "source_variants": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/migration_source_variant"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"schema_version": {"const": 2}}},
          "then": {"required": ["source_variants"]},
          "else": {"not": {"required": ["source_variants"]}}
        }
      ]
    }
  }
}
